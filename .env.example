# Keep keys server-side: never place them in web/ or git.
# Get a key from Panta after account registration: https://github.com/Kaito-HQ/panta-api-pub/blob/main/quickstart.mdx
PANTA_API_KEY=
PANTA_API_BASE_URL=https://live-api.panta.market/api/v1
# Optional OpenAI-compatible LLM endpoint (server only). Without it, explainable rules still work.
LLM_ENDPOINT=
LLM_API_KEY=
LLM_MODEL=
PORT=8787
